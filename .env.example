# Public origin for canonical URLs, Open Graph, sitemap, and robots.txt.
# Required on Vercel Production before HostGator DNS cutover.
NEXT_PUBLIC_SITE_URL=https://www.meadowlarkhomecare.com

# Resend API key. Without this, the contact form still works in
# local/preview mode and logs submissions to the server console.
RESEND_API_KEY=

# Must be a sender address on a domain verified in Resend.
CONTACT_FROM_EMAIL=Meadowlark Home Care <noreply@meadowlarkhomecare.com>

# Inbox that receives contact form submissions, apply, and staff access requests.
CONTACT_TO_EMAIL=hr@meadowlarkhomecare.com

# --- Staff auth (Auth.js / NextAuth v5) ---
# Required at runtime for Google SSO and magic-link sessions.
# Generate with: npx auth secret
# The app still builds if these are empty; sign-in shows a clear error instead.
AUTH_SECRET=

# Google Workspace OAuth (restrict the Cloud client to @meadowlarkhomecare.com).
# Authorized redirect: {AUTH_URL or site origin}/api/auth/callback/google
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional. Falls back to RESEND_API_KEY for magic-link and request-access email.
AUTH_RESEND_KEY=

# Optional on Vercel. Set for local/custom origins if callbacks miss the host.
# AUTH_URL=http://localhost:3000
# AUTH_TRUST_HOST=true

# Comma-separated AxisCare ACTIVE caregiver emails (case-insensitive).
# Also merged with src/data/caregiver-whitelist.json (placeholder, empty).
# TODO: Load the real AxisCare ACTIVE CSV before enabling the production gate.
STAFF_WHITELIST_EMAILS=

# Comma-separated admin emails. Defaults to cmerrill@meadowlarkhomecare.com.
# STAFF_ADMIN_EMAILS=cmerrill@meadowlarkhomecare.com
