# Public origin for canonical URLs, Open Graph, sitemap, and robots.txt.
# Required on Vercel Production before HostGator DNS cutover.
NEXT_PUBLIC_SITE_URL=https://www.meadowlarkhomecare.com

# Resend API key. Contact + apply read this name only.
# Staff magic-link + request-access prefer AUTH_RESEND_KEY, then fall back here.
# On Vercel, RESEND_API_KEY is already set — AUTH_RESEND_KEY is optional.
RESEND_API_KEY=

# Must be a sender address on a domain verified in Resend.
# Used for contact, apply, magic-link, and request-access email.
CONTACT_FROM_EMAIL=Meadowlark Home Care <noreply@meadowlarkhomecare.com>

# Inbox that receives contact form submissions, apply, and staff access requests.
CONTACT_TO_EMAIL=hr@meadowlarkhomecare.com

# --- Staff auth (Auth.js / NextAuth v5) ---
# Required at runtime for Google SSO and magic-link sessions.
# Generate with: npx auth secret
# The app still builds if these are empty; sign-in shows a clear error instead.
AUTH_SECRET=

# Google OAuth. Not domain-locked — personal Gmail and Workspace both work
# if the email is an admin or on the caregiver whitelist.
# Production callback (exact):
#   https://www.meadowlarkhomecare.com/api/auth/callback/google
# Local callback:
#   http://localhost:3000/api/auth/callback/google
# See STAFF_AUTH_SETUP.md for Cloud Console steps and Vercel preview URIs.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Optional Auth.js-style alias. Mirror RESEND_API_KEY if you want both names.
# Not required when RESEND_API_KEY is set (production already has that).
AUTH_RESEND_KEY=

# Canonical origin Auth.js and magic-link emails use for callbacks.
# Local: http://localhost:3000
# Vercel Production + Preview: https://www.meadowlarkhomecare.com
AUTH_URL=http://localhost:3000

# Required on Vercel so Auth.js trusts the forwarded host.
# src/auth.ts also sets trustHost: true; keep the env in sync.
AUTH_TRUST_HOST=true

# Optional extra AxisCare Active caregiver emails (case-insensitive).
# Primary list is src/data/staff-whitelist.csv.
STAFF_WHITELIST_EMAILS=

# Comma-separated admin emails. Replaces the defaults when set.
# Defaults: cmerrill@meadowlarkhomecare.com,corey.merrill@gmail.com
# STAFF_ADMIN_EMAILS=cmerrill@meadowlarkhomecare.com,corey.merrill@gmail.com
